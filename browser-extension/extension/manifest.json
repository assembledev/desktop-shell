{
  "manifest_version": 3,
  "name": "Desktop Shell Tabs",
  "version": "0.2.0",
  "description": "Expose open Firefox-compatible browser tabs to the local Desktop Shell launcher.",
  "permissions": [
    "nativeMessaging",
    "tabGroups",
    "tabs"
  ],
  "incognito": "not_allowed",
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "desktop-shell-tabs@desktop-shell.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  }
}
